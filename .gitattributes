*.xml     text eol=lf
*.properties text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.mjs     text eol=lf
*.toml    text eol=lf
*.tf      text eol=lf
*.csv     text eol=lf diff
*.txt     text eol=lf
